# Store the real file outside the checkout, e.g. /etc/qwen-image-api.env (0600).
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
IMAGE_SERVICE_API_TOKEN=
# Internal token is generated by the launcher on every start unless supplied here.
# IMAGE_SERVICE_INTERNAL_TOKEN=use-a-different-random-token
IMAGE_SERVICE_API_PORT=8000
IMAGE_SERVICE_COMFY_PORT=8188
IMAGE_SERVICE_QUEUE_SIZE=2
IMAGE_SERVICE_MAX_IMAGE_BYTES=16777216
IMAGE_SERVICE_MAX_REQUEST_BYTES=134217728
IMAGE_SERVICE_MAX_IMAGE_PIXELS=4194304
IMAGE_SERVICE_MAX_TOTAL_PIXELS=16777216
IMAGE_SERVICE_MAX_DIMENSION=8192
IMAGE_SERVICE_GATEWAY_MEMORY_BYTES=536870912
IMAGE_SERVICE_COMFY_MEMORY_BYTES=536870912
IMAGE_SERVICE_MAX_OUTPUT_BYTES=67108864
IMAGE_SERVICE_MAX_OUTPUT_PIXELS=8388608
IMAGE_SERVICE_MAX_PROMPT_CHARS=16384
IMAGE_SERVICE_MAX_PARTS=64
IMAGE_SERVICE_MAX_HEADER_BYTES=8192
IMAGE_SERVICE_UPLOAD_TIMEOUT=60
IMAGE_SERVICE_QUEUE_TIMEOUT=600
IMAGE_SERVICE_EXECUTION_TIMEOUT=900
IMAGE_SERVICE_CLEANUP_TIMEOUT=30
IMAGE_SERVICE_RESOURCE_TTL=120
# Optional pose search: build the snapshot first, then set its absolute path.
IMAGE_SERVICE_POSE_INDEX_PATH=
# Complete endpoint; replace the example host before enabling search.
IMAGE_SERVICE_POSE_EMBEDDING_URL=https://embedding.example.com/v1/embeddings
IMAGE_SERVICE_POSE_EMBEDDING_API_KEY=
IMAGE_SERVICE_POSE_EMBEDDING_CA_FILE=
# Explicit example for existing Qwen3 / 4096-dimensional indexes.
IMAGE_SERVICE_POSE_EMBEDDING_MODEL=Qwen3-Embedding-8B
IMAGE_SERVICE_POSE_EMBEDDING_DIMENSIONS=4096
# Build-time rule; runtime uses the instruction stored in the index. Empty = raw query.
IMAGE_SERVICE_POSE_EMBEDDING_QUERY_INSTRUCTION="Retrieve human pose descriptions that best match the requested body posture, limb positions, and contact relationships."
IMAGE_SERVICE_POSE_EMBEDDING_TIMEOUT=30
# Optional pose editing: install requirements-pose.txt and Chromium first.
# Default asset root is the installed VNCCS web directory under custom_nodes.
# IMAGE_SERVICE_POSE_ASSET_ROOT=/absolute/path/to/ComfyUI_VNCCS_Utils/web
IMAGE_SERVICE_POSE_BROWSER_PATH=
IMAGE_SERVICE_POSE_RENDER_TIMEOUT=30
IMAGE_SERVICE_MAX_POSE_BYTES=1048576

# Maintenance-only description tool; not read by the image API.
# Complete endpoint; export these variables when invoking the tool in a shell.
LLM_BASE_URL=https://vision.example.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=Qwen3.8-27B
# TLS CA and timeout for this tool use --ca-file and --timeout.
